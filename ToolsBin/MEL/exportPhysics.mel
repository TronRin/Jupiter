		+ "\t\t\t(  real \"MaxHitPoints\" ( group1  ) ( data 100.000000 )) \n" 

		+ "\t\t\t(  real \"Armor\" ( group1  ) ( data 100.000000 )) \n" 

		+ "\t\t\t(  real \"MaxArmor\" ( group1  ) ( data 100.000000 )) \n" 

		+ "\t\t\t(  longint \"DamageTriggerCounter\" ( group1  ) ( data 0.000000 )) \n" 

