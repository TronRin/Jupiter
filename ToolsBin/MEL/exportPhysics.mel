global proc exportPhysics()

{

	float 	$xTrans[], $yTrans[], $zTrans[], 

		$xRot[], $yRot[], $zRot[], $time[];

	float $prec = 0.0001;

	$filename = "C:/Documents and Settings/scotta/DESKTOP/keyFrames.lta";



	$sel = `ls -sl`;

	$numObj = size($sel);

	$object = $sel[0];

	int $numKeys = (`keyframe -q -kc`)/(6*$numObj);

	print ($numKeys + "\n");



	int $fileID = `fopen $filename "w"`;

	printPolyHedronList $fileID;

	printNodeHierarchy $fileID $sel $numKeys;



	fprint($fileID, "\t( globalproplist ( \n"

		+ "\t\t( proplist ( \n"

		+ "\t\t) ) \n");



	for($j = 0; $j < $numObj; $j++)

	{

		currentTime (`playbackOptions -q -min`);

		float $curTime = 0;

		for($i = 0; $i < $numKeys; $i++)

		{

			$prevTime = $curTime;

			$curTime = (float(`currentTime -q`))/30;

			$time[$i] = `roundOff ($curTime - $prevTime) 0.00001`;

				

			$xTrans[$i] = (`getAttr ($sel[$j] + ".tx")`) + (`getAttr ($sel[$j] + ".rpx")`);

			$xTrans[$i] = -(`roundOff $xTrans[$i] $prec`); //print($xTrans[$i] + "\n");

			$yTrans[$i] = (`getAttr ($sel[$j] + ".ty")`) + (`getAttr ($sel[$j] + ".rpy")`);

			$yTrans[$i] = `roundOff $yTrans[$i] $prec`; //print($yTrans[$i] + "\n");

			$zTrans[$i] = (`getAttr ($sel[$j] + ".tz")`) + (`getAttr ($sel[$j] + ".rpz")`);

			$zTrans[$i] = `roundOff $zTrans[$i] $prec`; //print($zTrans[$i] + "\n");



			$xRot[$i] = (`getAttr ($sel[$j] + ".rx")`); 	 $xRot[$i] = `deg_to_rad $xRot[$i]`;

			$xRot[$i] = `roundOff $xRot[$i] $prec`;

			$yRot[$i] = (`getAttr ($sel[$j] + ".ry")`);  $yRot[$i] = `deg_to_rad $yRot[$i]`;

			$yRot[$i] = -(`roundOff $yRot[$i] $prec`);

			$zRot[$i] = (`getAttr ($sel[$j] + ".rz")`);  $zRot[$i] = `deg_to_rad $zRot[$i]`;

			$zRot[$i] = -(`roundOff $zRot[$i] $prec`);

	

			currentTime -edit `findKeyframe -timeSlider -which next`;

		}

		printGlobalPropList $fileID $sel[$j] $xTrans $yTrans $zTrans $xRot $yRot $zRot $time;

	}



	fprint($fileID, "\t\t) ) \n"

		+ "\t( navigatorposlist ( \n"

		+ "\t) ) \n"

		+ ") \n");



	fclose $fileID;

}



global proc float roundOff(float $input, float $prec)

{

	float $output;

	if($input >=0)

		$output = float(int(($input/$prec) + 0.5))*$prec;

	else

		$output = float(int(($input/$prec) - 0.5))*$prec;

	return $output;

}



global proc printPolyHedronList(int $fileID)

{

	fprint	$fileID ("( world \n\n"

		+ "\t( header ( \n"

		+ "\t\t( versioncode 1 ) \n"

		+ "\t) ) \n"

		+ "\t( polyhedronlist ( \n"

		+ "\t) ) \n");

}



global proc printNodeHierarchy(int $fileID, string $name[], int $numKeys)

{

	fprint($fileID, "\t( nodehierarchy \n" 

		+ "\t\t( worldnode \n" 

		+ "\t\t\t( type null ) \n"

		+ "\t\t\t( label \"Container\" ) \n"		

		+ "\t\t\t( nodeid 1 )\n" 

		+ "\t\t\t( flags ( worldroot expanded ) )\n" 

		+ "\t\t\t( properties\n"

		+ "\t\t\t\t( propid  0 )\n" 

		+ "\t\t\t)\n"

 		+ "\t\t\t( childlist ( \n");

	int $lastProp = 1;	



	for($j = 0; $j<size($name); $j++)

	{

		fprint($fileID, "\t\t\t\t( worldnode \n"

			+ "\t\t\t\t\t( type null ) \n"

			+ "\t\t\t\t\t( label \"" + $name[$j] + "\" ) \n"

			+ "\t\t\t\t\t( flags ( expanded ) ) \n"

			+ "\t\t\t\t\t( properties \n"

			+ "\t\t\t\t\t\t( propid  0 ) \n"

			+ "\t\t\t\t\t) \n"

			+ "\t\t\t\t\t( childlist ( \n" 

			+ "\t\t\t\t\t\t( worldnode \n" 

			+ "\t\t\t\t\t\t\t( type object ) \n"

			+ "\t\t\t\t\t\t\t( flags ( expanded ) ) \n" 

			+ "\t\t\t\t\t\t\t( properties\n"

			+ "\t\t\t\t\t\t\t\t( name \"TranslucentWorldModel\" ) \n" 

			+ "\t\t\t\t\t\t\t\t( propid  " + ($lastProp) + " ) \n" 

			+ "\t\t\t\t\t\t\t) \n"

			+ "\t\t\t\t\t\t) \n"

			+ "\t\t\t\t\t\t( worldnode \n"

			+ "\t\t\t\t\t\t\t( type object ) \n"

			+ "\t\t\t\t\t\t\t( flags ( expanded ) ) \n" 

			+ "\t\t\t\t\t\t\t( properties \n"

			+ "\t\t\t\t\t\t\t\t( name \"KeyFramer\" ) \n" 

			+ "\t\t\t\t\t\t\t\t( propid  " + ($lastProp + 1) + " ) \n" 

			+ "\t\t\t\t\t\t\t) \n"

			+ "\t\t\t\t\t\t) \n"

			+ "\t\t\t\t\t\t( worldnode \n"

			+ "\t\t\t\t\t\t\t( type null ) \n"

			+ "\t\t\t\t\t\t\t( label \"" + $name[$j] + "Path\" ) \n" 

			+ "\t\t\t\t\t\t\t( flags ( path expanded ) ) \n" 

			+ "\t\t\t\t\t\t\t( properties \n"

			+ "\t\t\t\t\t\t\t\t( propid  0 ) \n" 

			+ "\t\t\t\t\t\t\t) \n"

			+ "\t\t\t\t\t\t\t( childlist ( \n");



		$lastProp += 2;



		for($i = 0; $i < $numKeys; $i++)

		{

			fprint($fileID, "\t\t\t\t\t\t\t\t( worldnode \n"

				+ "\t\t\t\t\t\t\t\t\t( type object ) \n"

				+ "\t\t\t\t\t\t\t\t\t( flags ( ) ) \n"

				+ "\t\t\t\t\t\t\t\t\t( properties \n"

				+ "\t\t\t\t\t\t\t\t\t\t( name \"Key\" ) \n"

				+ "\t\t\t\t\t\t\t\t\t\t( propid  " + ($i+$lastProp) + " ) \n"

				+ "\t\t\t\t\t\t\t\t\t) \n"

				+ "\t\t\t\t\t\t\t\t) \n");

		}



		$lastProp += $numKeys;

	

		fprint($fileID, "\t\t\t\t\t\t\t) ) \n"

			+ "\t\t\t\t\t\t) \n"

			+ "\t\t\t\t\t) ) \n"

			+ "\t\t\t\t) \n");

	}



	fprint($fileID, "\t\t\t) ) \n"

		+ "\t\t) \n"

		+ "\t) \n" );



}



global proc printGlobalPropList(int $fileID, string $object, float $xTrans[], float $yTrans[], float $zTrans[], float $xRot[], float $yRot[], float $zRot[], float $time[])

{

	string $keyname;

	int $numKeys = size($time);



	fprint($fileID, "\t\t( proplist ( \n"

