		+ "\t\t\t(  bool \"ShadowMaps\" ( hidden group2  ) ( data 0 )) \n" 

		+ "\t\t) ) \n");



	for($i = 0; $i < $numKeys; $i++)

	{

		if($i == 0)

			$keyname = $object + "Key0";

		else if($i < 10)

			$keyname = $object + "Key0" + $i;

		else 

			$keyname = $object + "Key" + $i;

	

		fprint($fileID, "\t\t( proplist ( \n" 

			+ "\t\t\t(  string \"Name\" (  ) ( data \"" + $keyname + "\") ) \n" 

